<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>false</SignAssembly>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>HVO.Astronomy.CFITSIO</RootNamespace>
    <AssemblyName>HVO.Astronomy.CFITSIO</AssemblyName>
    <PackageId>HVO.Astronomy.CFITSIO</PackageId>
    <Version>2.0.0</Version>
    <Description>Managed CFITSIO wrapper with bundled native binaries for Linux ARM64 and macOS ARM64.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageTags>Astronomy,FITS</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>HAS_SKIA</DefineConstants>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <NoWarn>$(NoWarn);CS1591;CS1572</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.151.1" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HVO.Astronomy.CFITSIO.NativeAssets/HVO.Astronomy.CFITSIO.NativeAssets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HVO.Core/HVO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="BUILD-FEATURES.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
